#!/usr/bin/env python3
"""Poll flake root inputs for updates without rewriting flake.lock.

For each direct input, resolve the unlocked flake ref with
`nix flake metadata --json` and compare the tip rev (or narHash) to the
lock. Temp `nix flake update` is not needed.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

DEFAULTS = {
    "nix": Path.home() / "src" / "nix-config",
    "nix-config": Path.home() / "src" / "nix-config",
    "lab": Path.home() / "src" / "homelab",
    "homelab": Path.home() / "src" / "homelab",
}


def color_enabled() -> bool:
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def paint(text: str, code: str) -> str:
    if not color_enabled():
        return text
    return f"\033[{code}m{text}\033[0m"


def flake_ref(original: dict) -> str:
    """Build an unlocked flake URL from a flake.lock `original` object."""
    t = original["type"]
    if t == "github":
        ref = f"github:{original['owner']}/{original['repo']}"
        if "ref" in original:
            ref += f"/{original['ref']}"
        return ref
    if t == "git":
        url = original["url"]
        if not url.startswith(("git+", "github:", "sourcehut:", "hg+")):
            url = f"git+{url}"
        if "ref" in original:
            url += ("&" if "?" in url else "?") + f"ref={original['ref']}"
        return url
    if t == "tarball":
        return original["url"]
    if t == "path":
        return original["path"]
    if t == "indirect":
        ident = original["id"]
        if "ref" in original:
            return f"flake:{ident}/{original['ref']}"
        return f"flake:{ident}"
    raise ValueError(f"unsupported input type {t!r}: {original}")


def metadata(url: str) -> dict:
    r = subprocess.run(
        ["nix", "flake", "metadata", url, "--json"],
        capture_output=True,
        text=True,
        check=False,  # we handle non-zero below
    )
    if r.returncode != 0:
        err = (r.stderr or r.stdout or "nix flake metadata failed").strip()
        raise RuntimeError(err.splitlines()[-1] if err else "metadata failed")
    return json.loads(r.stdout)


def tip_id(meta: dict) -> tuple[str, str]:
    """Return (kind, value) for the resolved tip — rev preferred, else narHash."""
    rev = meta.get("revision") or (meta.get("locked") or {}).get("rev")
    if rev:
        return "rev", rev
    nar = (meta.get("locked") or {}).get("narHash")
    if nar:
        return "narHash", nar
    raise RuntimeError("metadata has neither revision nor narHash")


def locked_id(locked: dict) -> tuple[str, str]:
    if rev := locked.get("rev"):
        return "rev", rev
    if nar := locked.get("narHash"):
        return "narHash", nar
    raise RuntimeError("lock has neither rev nor narHash")


def check_input(name: str, node: dict) -> tuple[str, str | None]:
    """Return (name, None) if current, (name, reason) if stale/error."""
    try:
        url = flake_ref(node["original"])
        meta = metadata(url)
        have_k, have_v = locked_id(node["locked"])
        tip_k, tip_v = tip_id(meta)
        if have_k == tip_k:
            if have_v == tip_v:
                return name, None
            return name, "stale"
        # Mixed keys: compare what we can
        if have_k == "rev" and tip_k == "rev" and have_v != tip_v:
            return name, "stale"
        if have_v != tip_v:
            return name, "stale"
        return name, None
    except Exception as e:  # noqa: BLE001 — surface per-input; keep scanning
        return name, f"error: {e}"


def check_flake(flake: Path) -> tuple[list[str], list[str]]:
    """Return (stale_or_error_names, error_details for verbose)."""
    lock_path = flake / "flake.lock"
    if not (flake / "flake.nix").is_file() or not lock_path.is_file():
        raise FileNotFoundError(f"need flake.nix + flake.lock in {flake}")

    lock = json.loads(lock_path.read_text())
    root = lock["nodes"][lock["root"]]
    jobs: list[tuple[str, dict]] = []
    for name, ref in root.get("inputs", {}).items():
        if isinstance(ref, list):
            continue  # follows — tip is owned by another input
        jobs.append((name, lock["nodes"][ref]))

    stale: list[str] = []
    details: list[str] = []
    # Parallel metadata fetches (each is a network round-trip).
    with ThreadPoolExecutor(max_workers=min(8, max(1, len(jobs)))) as pool:
        futs = [pool.submit(check_input, n, node) for n, node in jobs]
        for fut in as_completed(futs):
            name, reason = fut.result()
            if reason is None:
                continue
            stale.append(name)
            details.append(f"{name}: {reason}")

    stale.sort()
    details.sort()
    return stale, details


def resolve_flakes(args: list[str]) -> list[Path]:
    if not args:
        return [DEFAULTS["nix"], DEFAULTS["lab"]]
    out: list[Path] = []
    for a in args:
        if a in DEFAULTS:
            out.append(DEFAULTS[a])
        else:
            out.append(Path(a).expanduser())
    return out


def label_for(path: Path) -> str:
    # Prefer short names for the two defaults.
    for key in ("nix-config", "homelab"):
        if path.resolve() == DEFAULTS[key].resolve():
            return key
    return str(path)


def main() -> int:
    # writeShellApplication wraps the binary; keep help as "check-inputs", not the store hash.
    ap = argparse.ArgumentParser(
        prog="check-inputs",
        description="Check whether flake inputs have updates (no lock changes).",
    )
    ap.add_argument(
        "flakes",
        nargs="*",
        help="flake roots or aliases: nix, lab (default: both)",
    )
    ap.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="list which inputs are stale or failed",
    )
    ns = ap.parse_args()

    any_stale = False
    any_fail = False

    for flake in resolve_flakes(ns.flakes):
        label = label_for(flake)
        try:
            stale, details = check_flake(flake)
        except Exception as e:  # noqa: BLE001
            print(f"{paint('✗', '31')} {label}  ({e})")
            any_fail = True
            continue

        if not stale:
            print(f"{paint('✓', '32')} {label}")
        else:
            any_stale = True
            print(f"{paint('✗', '31')} {label}")
            if ns.verbose:
                for line in details:
                    print(f"    {line}")

    if any_fail:
        return 2
    return 1 if any_stale else 0


if __name__ == "__main__":
    sys.exit(main())
