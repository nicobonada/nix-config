#!/usr/bin/env python3
"""Check flake inputs; optionally update, activate, and commit locks.

  flake-up [nix|lab|…]           # report only (✓/✗ + stale detail)
  flake-up update [-y] [nix|lab] # same report, then confirm and update

Bare invocation never changes locks. `update` asks first unless --yes.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

DEFAULTS = {
    "nix": Path.home() / "src" / "nix-config",
    "nix-config": Path.home() / "src" / "nix-config",
    "lab": Path.home() / "src" / "homelab",
    "homelab": Path.home() / "src" / "homelab",
}

NIX_CONFIG = DEFAULTS["nix-config"].resolve()
HOMELAB = DEFAULTS["homelab"].resolve()


def color_enabled() -> bool:
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def paint(text: str, code: str) -> str:
    if not color_enabled():
        return text
    return f"\033[{code}m{text}\033[0m"


def flake_ref(original: dict) -> str:
    """Build an unlocked flake URL from a flake.lock `original` object."""
    t = original["type"]
    if t == "github":
        ref = f"github:{original['owner']}/{original['repo']}"
        if "ref" in original:
            ref += f"/{original['ref']}"
        return ref
    if t == "git":
        url = original["url"]
        if not url.startswith(("git+", "github:", "sourcehut:", "hg+")):
            url = f"git+{url}"
        if "ref" in original:
            url += ("&" if "?" in url else "?") + f"ref={original['ref']}"
        return url
    if t == "tarball":
        return original["url"]
    if t == "path":
        return original["path"]
    if t == "indirect":
        ident = original["id"]
        if "ref" in original:
            return f"flake:{ident}/{original['ref']}"
        return f"flake:{ident}"
    raise ValueError(f"unsupported input type {t!r}: {original}")


def metadata(url: str) -> dict:
    r = subprocess.run(
        ["nix", "flake", "metadata", url, "--json"],
        capture_output=True,
        text=True,
        check=False,
    )
    if r.returncode != 0:
        err = (r.stderr or r.stdout or "nix flake metadata failed").strip()
        raise RuntimeError(err.splitlines()[-1] if err else "metadata failed")
    return json.loads(r.stdout)


def tip_id(meta: dict) -> tuple[str, str]:
    rev = meta.get("revision") or (meta.get("locked") or {}).get("rev")
    if rev:
        return "rev", rev
    nar = (meta.get("locked") or {}).get("narHash")
    if nar:
        return "narHash", nar
    raise RuntimeError("metadata has neither revision nor narHash")


def locked_id(locked: dict) -> tuple[str, str]:
    if rev := locked.get("rev"):
        return "rev", rev
    if nar := locked.get("narHash"):
        return "narHash", nar
    raise RuntimeError("lock has neither rev nor narHash")


def check_input(name: str, node: dict) -> tuple[str, str | None]:
    try:
        url = flake_ref(node["original"])
        meta = metadata(url)
        have_k, have_v = locked_id(node["locked"])
        tip_k, tip_v = tip_id(meta)
        if have_k == tip_k:
            if have_v == tip_v:
                return name, None
            return name, "stale"
        if have_v != tip_v:
            return name, "stale"
        return name, None
    except Exception as e:  # noqa: BLE001 — keep scanning other inputs
        return name, f"error: {e}"


def check_flake(flake: Path) -> tuple[list[str], list[str]]:
    lock_path = flake / "flake.lock"
    if not (flake / "flake.nix").is_file() or not lock_path.is_file():
        raise FileNotFoundError(f"need flake.nix + flake.lock in {flake}")

    lock = json.loads(lock_path.read_text())
    root = lock["nodes"][lock["root"]]
    jobs: list[tuple[str, dict]] = []
    for name, ref in root.get("inputs", {}).items():
        if isinstance(ref, list):
            continue
        jobs.append((name, lock["nodes"][ref]))

    stale: list[str] = []
    details: list[str] = []
    with ThreadPoolExecutor(max_workers=min(8, max(1, len(jobs)))) as pool:
        futs = [pool.submit(check_input, n, node) for n, node in jobs]
        for fut in as_completed(futs):
            name, reason = fut.result()
            if reason is None:
                continue
            stale.append(name)
            details.append(f"{name}: {reason}")

    stale.sort()
    details.sort()
    return stale, details


def resolve_flakes(args: list[str]) -> list[Path]:
    if not args:
        return [DEFAULTS["nix"], DEFAULTS["lab"]]
    out: list[Path] = []
    for a in args:
        if a in DEFAULTS:
            out.append(DEFAULTS[a])
        else:
            out.append(Path(a).expanduser())
    return out


def label_for(path: Path) -> str:
    try:
        resolved = path.resolve()
    except OSError:
        return str(path)
    if resolved == NIX_CONFIG:
        return "nix-config"
    if resolved == HOMELAB:
        return "homelab"
    return str(path)


def run(cmd: list[str], *, cwd: Path | None = None) -> None:
    print("+", " ".join(cmd), flush=True)
    subprocess.run(cmd, cwd=cwd, check=True)


def network_full() -> bool:
    nmcli = shutil.which("nmcli")
    if not nmcli:
        return True
    r = subprocess.run(
        [nmcli, "networking", "connectivity", "check"],
        capture_output=True,
        text=True,
        check=False,
    )
    return r.stdout.strip() == "full"


def commit_lock(flake: Path) -> None:
    if not (flake / ".jj").is_dir() and not (flake / ".git").is_dir():
        print(f"  (no vcs in {flake}; skip lock commit)")
        return

    if shutil.which("jj") and (flake / ".jj").is_dir():
        r = subprocess.run(
            ["jj", "diff", "--name-only"],
            cwd=flake,
            capture_output=True,
            text=True,
            check=False,
        )
        names = {line.strip() for line in r.stdout.splitlines() if line.strip()}
        if "flake.lock" not in names:
            print("  (flake.lock unchanged; nothing to commit)")
            return
        run(["jj", "commit", "-m", "flake: update lock", "flake.lock"], cwd=flake)
        print("  committed flake.lock")
        return

    r = subprocess.run(
        ["git", "status", "--porcelain", "flake.lock"],
        cwd=flake,
        capture_output=True,
        text=True,
        check=False,
    )
    if not r.stdout.strip():
        print("  (flake.lock unchanged; nothing to commit)")
        return
    run(["git", "add", "flake.lock"], cwd=flake)
    run(["git", "commit", "-m", "flake: update lock"], cwd=flake)
    print("  committed flake.lock")


def update_nix_config(flake: Path) -> None:
    run(["nh", "os", "switch", "--update", str(flake)])
    if network_full():
        run(["nh", "home", "switch", str(flake)])
    else:
        print("skip home switch: network not full (nmcli)")
    commit_lock(flake)


def update_flake_only(flake: Path, *, note: str | None = None) -> None:
    run(["nix", "flake", "update", "--flake", str(flake)])
    commit_lock(flake)
    if note:
        print(note)


def update_one(flake: Path) -> None:
    label = label_for(flake)
    print(f"── update {label} ──", flush=True)
    if not flake.is_dir() or not (flake / "flake.nix").is_file():
        raise SystemExit(f"not a flake root: {flake}")

    try:
        resolved = flake.resolve()
    except OSError:
        resolved = flake

    if resolved == NIX_CONFIG:
        update_nix_config(flake)
    elif resolved == HOMELAB:
        update_flake_only(
            flake,
            note=(
                "homelab: lock updated + committed if dirty.\n"
                "  remote OS switch not run — when ready, from a workstation:\n"
                "  nh os switch . -H homelab --target-host <user@host>"
            ),
        )
    else:
        update_flake_only(
            flake,
            note=f"{label}: lock updated; activate this host yourself if needed.",
        )


def confirm_update(labels: list[str], *, yes: bool) -> bool:
    joined = ", ".join(labels)
    if yes:
        print(f"updating: {joined}")
        return True
    if not sys.stdin.isatty():
        print(
            "stale inputs and no TTY; re-run with --yes to update",
            file=sys.stderr,
        )
        return False
    try:
        reply = input(f"Update {joined}? [y/N] ").strip().lower()
    except EOFError:
        print()
        return False
    return reply in ("y", "yes")


def report(paths: list[Path]) -> tuple[list[Path], bool]:
    """Print ✓/✗ report. Return (stale flake paths, any_hard_failure)."""
    stale_paths: list[Path] = []
    any_fail = False

    for flake in paths:
        label = label_for(flake)
        try:
            stale, details = check_flake(flake)
        except Exception as e:  # noqa: BLE001
            print(f"{paint('✗', '31')} {label}  ({e})")
            any_fail = True
            continue

        if not stale:
            print(f"{paint('✓', '32')} {label}")
        else:
            print(f"{paint('✗', '31')} {label}")
            for line in details:
                print(f"    {line}")
            stale_paths.append(flake)

    return stale_paths, any_fail


def build_parser() -> argparse.ArgumentParser:
    # Fixed prog: writeShellApplication otherwise shows the store hash name.
    ap = argparse.ArgumentParser(
        prog="flake-up",
        description=(
            "Report whether flake inputs are current. "
            "Use the update subcommand to apply changes."
        ),
    )
    sub = ap.add_subparsers(dest="command")

    flake_help = "flake roots or aliases: nix, lab (default: both)"

    p_check = sub.add_parser(
        "check",
        help="report only (default if no subcommand)",
        description="Poll inputs and print ✓/✗ (no lock changes).",
    )
    p_check.add_argument("flakes", nargs="*", help=flake_help)

    p_upd = sub.add_parser(
        "update",
        help="update stale locks after confirmation",
        description=(
            "Report inputs, then with confirmation update stale locks, "
            "activate when local, and commit flake.lock."
        ),
    )
    p_upd.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="update without interactive confirmation",
    )
    p_upd.add_argument("flakes", nargs="*", help=flake_help)

    return ap


def normalize_argv(argv: list[str]) -> list[str]:
    """Default to `check` when the first token is not a subcommand."""
    if not argv:
        return ["check"]
    head = argv[0]
    if head in ("check", "update", "-h", "--help"):
        return argv
    # Global help only; flags like -y belong under `update`.
    if head.startswith("-"):
        return argv
    return ["check", *argv]


def cmd_check(flakes: list[str]) -> int:
    paths = resolve_flakes(flakes)
    _stale, any_fail = report(paths)
    if any_fail:
        return 2
    return 0


def cmd_update(flakes: list[str], *, yes: bool) -> int:
    paths = resolve_flakes(flakes)
    stale_paths, any_fail = report(paths)

    if any_fail:
        return 2
    if not stale_paths:
        return 0

    labels = [label_for(p) for p in stale_paths]
    if not confirm_update(labels, yes=yes):
        print("aborted")
        return 0

    for flake in stale_paths:
        try:
            update_one(flake)
        except subprocess.CalledProcessError as e:
            print(f"update failed for {label_for(flake)}: {e}", file=sys.stderr)
            return e.returncode or 1

    print("done")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    ap = build_parser()
    ns = ap.parse_args(normalize_argv(argv))

    if ns.command is None:
        # e.g. flake-up -h already handled; bare parse edge case
        ap.print_help()
        return 0

    if ns.command == "check":
        return cmd_check(list(ns.flakes))

    if ns.command == "update":
        return cmd_update(list(ns.flakes), yes=ns.yes)

    ap.error(f"unknown command {ns.command!r}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
