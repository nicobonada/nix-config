#!/usr/bin/env python3
"""Read/write VIA dynamic keymap on the Royal Kludge R87 Pro (USB).

Talks the QMK VIA raw-HID protocol on hidraw (usage page 0xFF60). No extra
deps — only the stdlib. Needs read/write on the board's VIA interface
(hardware.keyboard.qmk.enable usually grants that via uaccess).

Examples (fish):

  ./scripts/via-r87 dump > /tmp/map.json
  ./scripts/via-r87 get 1 3 2
  ./scripts/via-r87 set 1 3 2 0x0001          # KC_TRNS
  ./scripts/via-r87 apply keyboards/r87pro/keymap.json
  ./scripts/via-r87 find-mac                  # show Win/Mac layer switches

Keycodes of interest for this board:
  TO(0)=0x5200  TO(2)=0x5202  KC_TRNS=0x0001  KC_NO=0x0000
  Stock Mac enter: L1 (3,2) TO(2)   Mac exit: L3 (3,1) TO(0)
"""

from __future__ import annotations

import argparse
import json
import os
import select
import sys
import time
from pathlib import Path

VID = 0x342D
PID = 0xE48E
REPORT = 32
ROWS = 6
COLS = 17
# Descriptor: Usage Page 0xFF60, Usage 0x61, 32-byte in/out — iface that answers 0x01.
VIA_REPORT_MARKERS = (0x06, 0x60, 0xFF, 0x09, 0x61)


def _hidraw_for_r87() -> str:
    """Return /dev/hidrawN for the R87 VIA interface."""
    sysfs = Path("/sys/class/hidraw")
    if not sysfs.is_dir():
        raise SystemExit("no /sys/class/hidraw")
    candidates: list[tuple[int, str]] = []
    for entry in sorted(sysfs.iterdir()):
        uevent = (entry / "device" / "uevent").read_text()
        if "342D:0000E48E" not in uevent.upper().replace("0000342D", "342D"):
            # HID_ID=0003:0000342D:0000E48E
            if "0000342D:0000E48E" not in uevent.upper():
                continue
        name = entry.name  # hidrawN
        desc_path = entry / "device" / "report_descriptor"
        if not desc_path.is_file():
            continue
        desc = desc_path.read_bytes()
        # Prefer the raw-HID VIA interface (FF60/61).
        score = 2 if desc[:5] == bytes(VIA_REPORT_MARKERS) else 1
        candidates.append((score, f"/dev/{name}"))
    if not candidates:
        raise SystemExit(
            f"R87 Pro ({VID:04x}:{PID:04x}) not found — plug in USB and retry"
        )
    candidates.sort(reverse=True)
    return candidates[0][1]


class ViaR87:
    def __init__(self, path: str | None = None):
        self.path = path or _hidraw_for_r87()
        self.fd = os.open(self.path, os.O_RDWR)

    def close(self) -> None:
        os.close(self.fd)

    def __enter__(self) -> ViaR87:
        return self

    def __exit__(self, *_) -> None:
        self.close()

    def xfer(self, payload: list[int] | bytes, timeout: float = 0.5) -> bytes:
        buf = bytearray(REPORT)
        for i, b in enumerate(payload):
            buf[i] = b
        os.write(self.fd, bytes(buf))
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            raise TimeoutError(f"VIA timeout on {self.path} cmd=0x{buf[0]:02x}")
        return os.read(self.fd, 64)

    def protocol(self) -> int:
        r = self.xfer([0x01])
        return (r[1] << 8) | r[2]

    def layer_count(self) -> int:
        r = self.xfer([0x11])
        return r[1]

    def get(self, layer: int, row: int, col: int) -> int:
        r = self.xfer([0x04, layer, row, col])
        if r[0] != 0x04:
            raise RuntimeError(f"bad get response: {r[:6].hex()}")
        return (r[4] << 8) | r[5]

    def set(self, layer: int, row: int, col: int, keycode: int) -> None:
        self.xfer(
            [
                0x05,
                layer,
                row,
                col,
                (keycode >> 8) & 0xFF,
                keycode & 0xFF,
            ]
        )
        time.sleep(0.015)
        got = self.get(layer, row, col)
        if got != keycode:
            raise RuntimeError(
                f"verify failed L{layer}({row},{col}): "
                f"want 0x{keycode:04X} got 0x{got:04X}"
            )

    def dump(self) -> dict:
        layers = self.layer_count()
        keymap = [
            [[self.get(L, r, c) for c in range(COLS)] for r in range(ROWS)]
            for L in range(layers)
        ]
        return {
            "device": {
                "vendorId": hex(VID),
                "productId": hex(PID),
                "name": "R87Pro",
                "hidraw": self.path,
            },
            "via_protocol": self.protocol(),
            "matrix": {"rows": ROWS, "cols": COLS},
            "layers": layers,
            "keymap": keymap,
        }

    def apply(self, data: dict, dry_run: bool = False) -> int:
        """Write keymap from dump JSON. Returns number of cells changed."""
        km = data["keymap"]
        changed = 0
        for layer, rows in enumerate(km):
            for row, cols in enumerate(rows):
                for col, want in enumerate(cols):
                    cur = self.get(layer, row, col)
                    if cur == want:
                        continue
                    changed += 1
                    if dry_run:
                        print(
                            f"  would set L{layer}({row},{col}) "
                            f"0x{cur:04X} -> 0x{want:04X}"
                        )
                    else:
                        self.set(layer, row, col, want)
        return changed


def _parse_kc(s: str) -> int:
    s = s.strip().lower()
    if s.startswith("0x"):
        return int(s, 16)
    return int(s, 0)


def cmd_dump(args: argparse.Namespace) -> None:
    with ViaR87(args.device) as via:
        data = via.dump()
    text = json.dumps(data, indent=2) + "\n"
    if args.output:
        Path(args.output).write_text(text)
        print(f"wrote {args.output}", file=sys.stderr)
    else:
        sys.stdout.write(text)


def cmd_get(args: argparse.Namespace) -> None:
    with ViaR87(args.device) as via:
        kc = via.get(args.layer, args.row, args.col)
    print(f"L{args.layer}({args.row},{args.col}) = 0x{kc:04X} ({kc})")


def cmd_set(args: argparse.Namespace) -> None:
    kc = _parse_kc(args.keycode)
    with ViaR87(args.device) as via:
        before = via.get(args.layer, args.row, args.col)
        via.set(args.layer, args.row, args.col, kc)
    print(
        f"L{args.layer}({args.row},{args.col}): "
        f"0x{before:04X} -> 0x{kc:04X}"
    )


def cmd_apply(args: argparse.Namespace) -> None:
    data = json.loads(Path(args.file).read_text())
    with ViaR87(args.device) as via:
        n = via.apply(data, dry_run=args.dry_run)
    action = "would change" if args.dry_run else "changed"
    print(f"{action} {n} cells")


def cmd_find_mac(args: argparse.Namespace) -> None:
    """Locate Win/Mac layer switches (TO(0)/TO(2)) and show modifier order."""
    with ViaR87(args.device) as via:
        layers = via.layer_count()
        print(f"device {via.path}  protocol={via.protocol()}  layers={layers}")
        print("layer switches (TO/DF/TG/MO):")
        for L in range(layers):
            for r in range(ROWS):
                for c in range(COLS):
                    kc = via.get(L, r, c)
                    if 0x5200 <= kc <= 0x52FF:
                        kind = {
                            range(0x5200, 0x5220): "TO",
                            range(0x5220, 0x5240): "MO",
                            range(0x5240, 0x5260): "DF",
                            range(0x5260, 0x5280): "TG",
                        }
                        label = "?"
                        for rng, name in kind.items():
                            if kc in rng:
                                label = f"{name}({kc - rng.start})"
                                break
                        print(f"  L{L} ({r},{c}) {label} 0x{kc:04X}")
        print("bottom-row mods L0 vs L2:")
        for L in (0, 2):
            mods = []
            for c in (0, 1, 2, 8, 11):
                kc = via.get(L, 5, c)
                name = {
                    0xE0: "LCTL",
                    0xE1: "LSFT",
                    0xE2: "LALT",
                    0xE3: "LGUI",
                    0xE6: "RALT",
                    0xE7: "RGUI",
                    0xE4: "RCTL",
                }.get(kc, f"0x{kc:04X}")
                mods.append(f"(5,{c})={name}")
            print(f"  L{L}: " + " ".join(mods))


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument(
        "--device",
        help="hidraw path (default: auto-detect R87 VIA iface)",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("dump", help="dump full keymap as JSON")
    d.add_argument("-o", "--output", help="write to file instead of stdout")
    d.set_defaults(func=cmd_dump)

    g = sub.add_parser("get", help="get one keycode")
    g.add_argument("layer", type=int)
    g.add_argument("row", type=int)
    g.add_argument("col", type=int)
    g.set_defaults(func=cmd_get)

    s = sub.add_parser("set", help="set one keycode (hex or int)")
    s.add_argument("layer", type=int)
    s.add_argument("row", type=int)
    s.add_argument("col", type=int)
    s.add_argument("keycode", help="e.g. 0x0001 or 1 for KC_TRNS")
    s.set_defaults(func=cmd_set)

    a = sub.add_parser("apply", help="apply a dump JSON to the board")
    a.add_argument("file")
    a.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="show diffs only",
    )
    a.set_defaults(func=cmd_apply)

    f = sub.add_parser(
        "find-mac",
        help="show Mac/Win layer switch keycodes and mod order",
    )
    f.set_defaults(func=cmd_find_mac)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
