// Session startup - included from default.nix.

// Background (host-gated)
// solaar: nixos/common/solaar.nix (graphical-session; both seats)
// 1Password and Steam: home/services/session-tray.nix
// wayland-pipewire-idle-inhibit: store path from niri.nix (not on PATH)

// Desktop apps
spawn-at-startup "kitty"
spawn-at-startup "brave-work"
// Personal Brave (app-id brave-personal) — ASUS on oakhill only.
// Missing output: niri falls back to the focused monitor; do not spawn on seyruun.
spawn-sh-at-startup "[ $(hostname) = 'oakhill' ] && brave-personal"
