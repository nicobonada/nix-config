// Window and layer rules for niri — included from niri.nix.
//
// Do not set a global open-floating false: that overrides niri's auto-float for
// parented dialogs and fixed-size windows (e.g. 1Password authorize), which
// then open tiled and shove the strip. Stock default already tiles normal apps.

// Gamescope nest on the ultrawide.
//
// VRR: outputs use variable-refresh-rate on-demand=true. That only *arms* VRR
// when a window with variable-refresh-rate true is shown — it does not force
// VRR always-on for the desktop. Match gamescope only: the game presents to
// gamescope; gamescope (--adaptive-sync) presents to niri. Bare steam_app_*
// windows (e.g. Quake on plain GE-Proton) skip niri VRR on purpose.
//
// Steam Play: compat tool "Gamescope + GE-Proton" (gamescope-ge-proton.nix).
// Native Linux titles: per-game launch options if you want gamescope.
window-rule {
  match app-id="^gamescope$"

  open-on-output "LG Electronics LG ULTRAWIDE 501NTDV76274"
  variable-refresh-rate true
  geometry-corner-radius 0
}

// Recreation Brave: always the ASUS. Harmless if that output is unplugged
// (niri opens on the focused monitor instead).
window-rule {
  match app-id="^brave-docked$"
  open-on-output "ASUSTek COMPUTER INC VG258 MBLMQS146465"
}

// Work Brave session restore: keep it on the ultrawide at niri startup.
// After 60s, Mod+O follows the focused output as usual.
window-rule {
  match app-id="^brave-browser$" at-startup=true
  open-on-output "LG Electronics LG ULTRAWIDE 501NTDV76274"
}

// Hatsune Miku Logic Paint S+ tries to run at 1920x800 (?)
window-rule {
  match title="MikuLogiS+"

  open-fullscreen false
}

// Terminal
window-rule {
  match app-id="^kitty$"
  default-column-width { proportion 0.333333; }
}

// Don't open Steam notifications in the center of the screen
window-rule {
  match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
  default-floating-position x=10 y=10 relative-to="bottom-right"
}

// Noctalia: rounded corners + clip
window-rule {
  // Rounded corners for a modern look.
  geometry-corner-radius 8

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

// Floating Noctalia settings window
window-rule {
  match app-id="dev.noctalia.Noctalia.Settings"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

// Satty screenshot annotator
window-rule {
  match app-id="^com\\.gabm\\.satty$"
  open-floating true
}

// Blurred overview wallpaper (needs [niri/backdrop] in Noctalia)
layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

// Apps: blur without xray
window-rule {
  background-effect {
    blur true
    xray false
  }
}

// Noctalia surfaces: no xray (blur regions come from Noctalia when available)
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
    // blur false
  }
}
