// Session startup — included from niri.nix.

// Background and tray (host-gated)
// solaar: NixOS programs.solaar.userService on oakhill (graphical-session)
spawn-sh-at-startup "[ $(hostname) = 'oakhill' ] && app2unit -- steam -silent"
// wayland-pipewire-idle-inhibit: store path from niri.nix (not on PATH)

// Desktop apps
spawn-at-startup "kitty"
spawn-at-startup "brave-work"
// Personal Brave (app-id brave-personal) — ASUS on oakhill only.
// Missing output: niri falls back to the focused monitor; do not spawn on seyruun.
spawn-sh-at-startup "[ $(hostname) = 'oakhill' ] && brave-personal"
spawn-at-startup "trilium"
// 1Password: tray + CLI/browser unlock (system package via programs._1password-gui)
spawn-at-startup "1password"
